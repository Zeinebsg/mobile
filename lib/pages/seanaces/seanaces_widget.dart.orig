  bool _matchesDateFilter(DateTime? seanceDate) {
    if (seanceDate == null) return false;
    if (_dateFilter == 'tous') return true;
    
    final today = DateTime.now();
    final seanceDay = DateTime(seanceDate.year, seanceDate.month, seanceDate.day);
    
    switch (_dateFilter) {
      case 'aujourdhui':
        final todayDay = DateTime(today.year, today.month, today.day);
        return seanceDay == todayDay;
      case 'demain':
        final tomorrowDay = DateTime(today.year, today.month, today.day + 1);
        return seanceDay == tomorrowDay;
      default:
        if (_selectedDate != null) {
          return seanceDay == _selectedDate;
        }
        return true;
    }
  }

  String _formatDate(DateTime? dt) {
    if (dt == null) return 'Date inconnue';
    return '${dt.day}/${dt.month}/${dt.year}';
  }

  String _formatTime(DateTime? dt) {
    if (dt == null) return 'Heure inconnue';
    return '${dt.hour.toString().padLeft(2, '0')}:${dt.minute.toString().padLeft(2, '0')}';
  }

  String _formatDayMonth(DateTime? dt) {
    if (dt == null) return 'Date';
    return '${dt.day}/${dt.month}';
  }

  String _formatHourMinute(DateTime? dt) {
    if (dt == null) return 'Horaire';
    return '${dt.hour.toString().padLeft(2, '0')}h${dt.minute.toString().padLeft(2, '0')}';
  }

